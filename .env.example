# ──────────────────────────────────────────────
# Gauntlet Forge — Environment Variables
# ──────────────────────────────────────────────

# ── Session ──
# No sign-in is required; everyone uses a shared guest session.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# Optional: lets "Approve & Push" open pull requests (needs `repo` scope).
# Without it, use "Download project (.zip)" instead.
GITHUB_PUBLISH_TOKEN=

# ── Database ──
DATABASE_URL=postgresql://forge:forge_dev@localhost:5433/forge
POSTGRES_PASSWORD=forge_dev

# ── Encryption ──
ENCRYPTION_KEY=

# ── LLM API Keys ──
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ── Google OAuth2 (Gateway) ──
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Gateway ──
JWT_SECRET_KEY=
JWT_EXPIRY_HOURS=24
GATEWAY_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ── Rate Limiting ──
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ── CORS ──
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
